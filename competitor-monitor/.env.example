# Obrigatório para varredura e monitoramento
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Modelo de classificação (padrão: Haiku — não alterar sem justificativa)
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Limite de conteúdo por página (chars) — defesa contra token explosion
MAX_CONTENT_CHARS=15000

# E-mail — só ativar após aprovação do baseline
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_RECIPIENT=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
